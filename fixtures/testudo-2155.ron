(label: "DCK-01", kind: Console, room: "R1", maker: "Vostok", part: "VK-T1", serial: "VK-2149-9002", made: 2149.05, condition: 1.0, draw_a: 1),
(label: "V-01", kind: Valve(open: true), room: "R2", maker: "Vostok", part: "VK-V2", serial: "VK-2149-5501", made: 2149.05, condition: 1.0, draw_a: 0),
