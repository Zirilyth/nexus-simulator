(label: "HTR-01", kind: Heater, room: "R1", maker: "Kirin", part: "KH-77", serial: "KR-2151-0817", made: 2151.40, condition: 0.71, draw_a: 16),
(label: "PMP-01", kind: Pump, room: "R2", maker: "Vostok", part: "VK-P60", serial: "VK-2149-6612", made: 2149.05, condition: 1.0, draw_a: 4),
(label: "SNS-01", kind: Sensor, room: "R1", maker: "Vostok", part: "VK-X4", serial: "VK-2149-8830", made: 2149.05, condition: 1.0, draw_a: 0),
(label: "LT-01", kind: Lights, room: "R1", maker: "Vostok", part: "VK-L8", serial: "VK-2149-3341", made: 2149.05, condition: 1.0, draw_a: 2),
